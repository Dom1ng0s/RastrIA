VITE_API_URL=http://localhost:8000/api

# Modo demonstração (issue #128) — expõe o atalho de login por papel e o
# botão "Modo demo" das listas. Ligado por padrão em desenvolvimento; deve
# ficar DESLIGADO em qualquer deploy de piloto ou produção.
VITE_MODO_DEMO=true

# Monitoramento de erros (issue #188) — opcional; só vale no build de produção.
# Sem VITE_SENTRY_DSN, o SDK nem é baixado. O host do DSN entra sozinho no
# connect-src da CSP. As três SENTRY_* só servem para enviar os source maps no
# build (que são apagados de dist/ depois do envio) — não são expostas ao app.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
