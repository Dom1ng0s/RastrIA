SECRET_KEY=troque-por-uma-chave-secreta
DJANGO_SETTINGS_MODULE=rastria.settings.dev
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sessão (issue #190) — ver "Sessão e cookies" em agents/claude.md.
# JWT_ORIGENS_PERMITIDAS=   (padrão: CORS_ALLOWED_ORIGINS)
# JWT_COOKIE_SECURE=true    (dev.py já desliga para localhost)
# JWT_COOKIE_SAMESITE=Strict

# Monitoramento de erros (issue #188) — opcional. Sem SENTRY_DSN nada é enviado.
# DJANGO_LOG_LEVEL=INFO
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
